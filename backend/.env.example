# ========================================
# RESQAI Backend Environment Configuration
# ========================================

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=5000

# Database Configuration
# Replace with your actual MongoDB connection string
# Local MongoDB: mongodb://localhost:27017/resqai
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/resqai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/resqai

# JWT Configuration
# Generate a secure random string for JWT_SECRET (e.g., openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ML Service Configuration
# URL where your ML classification service is running
ML_SERVICE_URL=http://localhost:8000
CONFIDENCE_THRESHOLD=0.70

# CORS Configuration (optional)
# Comma-separated list of allowed origins
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limiting (optional)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Logging (optional)
# LOG_LEVEL=info
