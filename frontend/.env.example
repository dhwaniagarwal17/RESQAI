# ========================================
# RESQAI Frontend Environment Configuration
# ========================================

# API Base URL (optional)
# If not set, uses Vite proxy configured in vite.config.js
# Development: Leave commented (uses proxy)
# Production: Set to your backend URL
# VITE_API_URL=http://localhost:5000/api

# Example for production deployment:
# VITE_API_URL=https://api.resqai.com/api
